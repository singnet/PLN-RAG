      "statement_atoms": [
        "(: rain (BranchContext rain actual_root counterfactual 0.5) (STV 1 1))",
        "(: dry (BranchContext dry actual_root counterfactual 0.5) (STV 1 1))",
        "(: wet (InContext rain none (Wet ground)) (STV 1 1))"
      ],
      "query_atoms": [
        "(: $prf (InContext dry none (Wet ground)) $tv)"
      ],
      "expected_proof": false,
      "stage7_expectation": {"branch_id": "dry", "minimum_theory_statements": 0, "denial_reason": "branch_not_inherited"}
