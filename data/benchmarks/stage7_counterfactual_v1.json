{
  "suite_id": "stage7_counterfactual_v1",
  "description": "Deterministic Stage 7 capability and isolation comparison using reviewed generated MeTTa fixtures.",
  "version": "1.0",
  "cases": [
    {
      "case_id": "S701",
      "name": "branch_local_rule",
      "category": "authorized_positive",
      "input_text": "In the rain counterfactual, wet ground would be slippery.",
      "user_query": "In the rain counterfactual, would the ground be slippery?",
      "statement_atoms": [
        "(: rain (BranchContext rain actual_root counterfactual 0.4) (STV 1 1))",
        "(: dry (BranchContext dry actual_root counterfactual 0.6) (STV 1 1))",
        "(: wet (InContext rain none (Wet ground)) (STV 1 1))",
        "(: wet_rule (InContext rain none (Implication (Premises (Wet $x)) (Conclusions (Slippery $x)))) (STV 1 1))"
      ],
      "query_atoms": [
        "(: $prf (InContext rain none (Slippery ground)) $tv)"
      ],
      "expected_proof": true,
      "stage7_expectation": {"branch_id": "rain", "minimum_theory_statements": 2, "branch_probability": 0.4}
    },
    {
      "case_id": "S702",
      "name": "actual_ancestor_inheritance",
      "category": "authorized_positive",
      "input_text": "The ground has a seed in actuality, and a rain counterfactual is considered.",
      "user_query": "In the rain counterfactual, does the ground have a seed?",
      "statement_atoms": [
        "(: rain (BranchContext rain actual_root counterfactual 0.4) (STV 1 1))",
        "(: seed (Seed ground) (STV 1 1))"
      ],
      "query_atoms": [
        "(: $prf (InContext rain none (Seed ground)) $tv)"
      ],
      "expected_proof": true,
      "stage7_expectation": {"branch_id": "rain", "minimum_theory_statements": 1, "branch_probability": 0.4}
    },
    {
      "case_id": "S703",
      "name": "nested_branch_inheritance",
      "category": "authorized_positive",
      "input_text": "A battery is charged in actuality. In a projected forecast, charged batteries are powered. In its rain counterfactual, powered batteries are ready. In a nested storm counterfactual, ready batteries are operational.",
      "user_query": "In the nested storm counterfactual, is the battery operational?",
      "statement_atoms": [
        "(: forecast (BranchContext forecast actual_root projected 0.8) (STV 1 1))",
        "(: rain (BranchContext rain forecast counterfactual 0.5) (STV 1 1))",
        "(: storm (BranchContext storm rain counterfactual 0.25) (STV 1 1))",
        "(: dry (BranchContext dry forecast counterfactual 0.5) (STV 1 1))",
        "(: charged (Charged battery) (STV 1 1))",
        "(: power_rule (InContext forecast none (Implication (Premises (Charged $x)) (Conclusions (Powered $x)))) (STV 1 1))",
        "(: ready_rule (InContext rain none (Implication (Premises (Powered $x)) (Conclusions (Ready $x)))) (STV 1 1))",
        "(: operation_rule (InContext storm none (Implication (Premises (Ready $x)) (Conclusions (Operational $x)))) (STV 1 1))"
      ],
      "query_atoms": [
        "(: $prf (InContext storm none (Operational battery)) $tv)"
      ],
      "expected_proof": true,
      "stage7_expectation": {"branch_id": "storm", "minimum_theory_statements": 4, "branch_probability": 0.1}
    },
    {
      "case_id": "S704",
      "name": "sibling_branch_isolation",
      "category": "safety_negative",
      "input_text": "The ground is wet only in the rain counterfactual, not in the dry sibling.",
